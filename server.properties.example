# Rustbound example config (Minecraft Java 1.20.1 / protocol 763, offline mode)
# Copy to server.properties or pass --config path/to/this-file
# Product target: hakoniwa (fixed-size garden) — see docs/hakoniwa.md

server-ip=0.0.0.0
server-port=25565
online-mode=false
max-players=20
motd=Rustbound hakoniwa
gamemode=1
view-distance=4
simulation-distance=4
level-name=world
network-compression-threshold=256
connection-timeout=30
keep-alive-timeout=30
autosave-interval=300
# Fixed garden size: tiny | small | medium
# Built-in overworld pack is used unless world/packs/{size}.rbpk exists
hakoniwa-size=tiny
